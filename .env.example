APP_ENV=development
TRADING_MODE=OBSERVATION
LIVE_ENABLED=false
# Generate locally: uv run python -m scripts.hash_password (hidden password prompt)
ADMIN_PASSWORD_HASH=
DATABASE_URL=postgresql+psycopg://algotrade:replace-locally@db:5432/algotrade
POSTGRES_USER=algotrade
POSTGRES_DB=algotrade
POSTGRES_PASSWORD=
COOKIE_SECURE=false
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
ALLOWED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]

# Optional Phase 2 read-only connection. Never paste secrets into chat.
# Generate an Analytics Token in Upstox Developer Apps; configure it locally only.
UPSTOX_ANALYTICS_TOKEN=
# Copy the actual expiry from the broker console, including a timezone offset.
# Leave the token blank and expiry commented until a token is configured.
# UPSTOX_ANALYTICS_EXPIRES_AT=2027-01-01T00:00:00+05:30
